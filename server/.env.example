# MongoDB Atlas 연결 URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/daylog?retryWrites=true&w=majority

# 서버 포트 (Render는 자동 할당하므로 로컬 개발용)
PORT=5000

# 환경
NODE_ENV=production

# 프론트엔드 도메인 (Vercel 배포 후 실제 URL로 변경)
CLIENT_URL=https://day-log-client.vercel.app

# 서버 자신의 URL (Render 배포 후 실제 URL로 변경)
SERVER_URL=https://your-server.onrender.com

# Google OAuth (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT 서명 키 (랜덤 문자열, 예: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key

# 세션 시크릿 (JWT_SECRET과 달라도 됨)
SESSION_SECRET=your-session-secret
